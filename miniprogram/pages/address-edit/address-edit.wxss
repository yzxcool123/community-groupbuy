.page {
  padding: 20rpx 24rpx 40rpx;
}

.form-item {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  border-bottom: 1rpx solid #F0F1F3;
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  width: 140rpx;
  font-size: 26rpx;
  color: #646A73;
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  height: 96rpx;
  font-size: 28rpx;
  color: #1F2329;
}

.tip {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #8B919B;
  text-align: center;
}

.del-btn {
  margin: 32rpx 0 0;
}
