.page {
padding-bottom: 40rpx;
}

.gallery {
  width: 100%;
  height: 560rpx;
  background: #FFFFFF;
}

.gallery-img {
  width: 100%;
  height: 560rpx;
  display: block;
}

.price-card {
  background: #FFFFFF;
  padding: 28rpx 28rpx 24rpx;
}

.price-row {
  gap: 12rpx;
}

.price .price-num {
  font-size: 48rpx;
}

.muted {
  color: #646A73;
  font-size: 22rpx;
}

.p-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1F2329;
  margin: 16rpx 0 14rpx;
  line-height: 1.45;
}

.p-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.spec-card {
  margin-top: 16rpx;
}

.spec-label {
  font-size: 24rpx;
  color: #646A73;
  margin-bottom: 6rpx;
}

.spec-value {
  font-size: 28rpx;
  color: #1F2329;
  font-weight: 500;
}

.arrow {
  color: #B0B6BF;
  font-size: 36rpx;
}

.detail-head {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}

.detail-text {
  font-size: 26rpx;
  color: #646A73;
  line-height: 1.7;
  white-space: pre-wrap;
  word-break: break-all;
}

/* 底部 */
.foot-icon {
  position: relative;
  width: 100rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.foot-emoji {
  font-size: 40rpx;
  line-height: 1;
}

.foot-text {
  font-size: 20rpx;
  color: #646A73;
  margin-top: 4rpx;
}

.cart-badge {
  position: absolute;
  top: -10rpx;
  right: 12rpx;
  background: #FA2C19;
  color: #FFFFFF;
  font-size: 18rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.foot-btn {
  flex: 1;
  margin-left: 12rpx;
  height: 76rpx;
}

/* SKU 弹层 */
.sku-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.sku-panel {
  width: 100%;
  background: #FFFFFF;
  border-radius: 24rpx 24rpx 0 0;
  padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  max-height: 78vh;
  overflow-y: auto;
}

.sku-top {
  display: flex;
  margin-bottom: 28rpx;
}

.sku-cover {
  width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
  background: #F2F3F5;
  flex-shrink: 0;
}

.sku-top-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding-bottom: 8rpx;
}

.sku-stock {
  margin-top: 8rpx;
}

.sku-sel {
  font-size: 24rpx;
  color: #646A73;
  margin-top: 6rpx;
}

.sku-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #B0B6BF;
  font-size: 32rpx;
}

.sku-section {
  margin-bottom: 28rpx;
}

.sku-section-title {
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
  color: #1F2329;
}

.sku-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.sku-chip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 28rpx;
  background: #F2F3F5;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #1F2329;
  border: 2rpx solid transparent;
}

.sku-chip.on {
  background: rgba(255, 103, 0, 0.1);
  color: #FF6700;
  border-color: #FF6700;
  font-weight: 600;
}

.sku-chip.disabled {
  opacity: 0.4;
}

.sku-spec {
  font-size: 20rpx;
  color: #8B919B;
}

.sku-chip.on .sku-spec {
  color: #FF6700;
}

.stepper {
  display: flex;
  align-items: center;
  background: #F2F3F5;
  border-radius: 12rpx;
  overflow: hidden;
}

.step-btn {
  width: 64rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #1F2329;
  background: #FFFFFF;
}

.step-num {
  width: 80rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
}

.sku-actions {
  margin-top: 16rpx;
}
