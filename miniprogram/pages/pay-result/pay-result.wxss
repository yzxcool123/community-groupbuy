.page {
min-height: 100vh;
  background: #FFFFFF;
  padding: 80rpx 48rpx 48rpx;
}

.result-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.icon-circle {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  color: #FFFFFF;
  margin-bottom: 32rpx;
  font-weight: 700;
}

.icon-circle.success {
  background: linear-gradient(135deg, #FF6700, #E85D00);
}

.icon-circle.fail {
  background: linear-gradient(135deg, #FA2C19, #E1251B);
}

.icon-circle.paying {
  background: linear-gradient(135deg, #8B919B, #646A73);
}

.result-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1F2329;
  margin-bottom: 12rpx;
}

.result-sub {
  font-size: 26rpx;
  color: #646A73;
  text-align: center;
  line-height: 1.6;
}

.order-no {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #8B919B;
  background: #F7F8FA;
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
}

.result-card {
  width: 100%;
  background: #F7F8FA;
  border-radius: 12rpx;
  padding: 28rpx;
  margin-top: 48rpx;
}

.rc-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.rc-label {
  color: #646A73;
  font-size: 26rpx;
}

.rc-val {
  color: #1F2329;
  font-size: 26rpx;
  font-weight: 500;
}

.rc-tip {
  margin-top: 12rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #E5E6EB;
  font-size: 22rpx;
  color: #FF6700;
  text-align: center;
}

.btns {
  width: 100%;
  margin-top: 56rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
