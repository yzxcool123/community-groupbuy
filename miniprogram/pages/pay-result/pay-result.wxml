<view class="page">
  <!-- 成功 -->
  <view class="result-wrap" wx:if="{{status === 'success'}}">
    <view class="icon-circle success">✓</view>
    <view class="result-title">{{resultTitle}}</view>
    <view class="result-sub">{{payMsg}}</view>
    <view class="order-no" wx:if="{{orderNo}}">订单号：{{orderNo}}</view>

    <view class="result-card">
      <view class="rc-row">
        <text class="rc-label">订单状态</text>
        <text class="badge badge-primary">{{statusBadgeText}}</text>
      </view>
      <view class="rc-row">
        <text class="rc-label">履约方式</text>
        <text class="rc-val">{{fulfillmentText}}</text>
      </view>
      <view class="rc-tip">{{cardTip}}</view>
    </view>

    <view class="btns">
      <view class="btn btn-primary btn-block" wx:if="{{showVerifyCodeBtn}}" bindtap="goVerifyCode">查看核销码</view>
      <view class="btn btn-outline btn-block" bindtap="goOrderDetail">查看订单</view>
      <view class="btn btn-ghost btn-block" bindtap="goHome">返回首页</view>
    </view>
  </view>

  <!-- 支付中 -->
  <view class="result-wrap" wx:elif="{{status === 'paying'}}">
    <view class="icon-circle paying">…</view>
    <view class="result-title">正在支付</view>
    <view class="result-sub">模拟支付处理中，请稍候</view>
  </view>

  <!-- 失败 -->
  <view class="result-wrap" wx:else>
    <view class="icon-circle fail">✕</view>
    <view class="result-title">支付失败</view>
    <view class="result-sub">{{payMsg}}</view>

    <view class="btns">
      <view class="btn btn-primary btn-block" bindtap="retry">重新支付</view>
      <view class="btn btn-outline btn-block" bindtap="goOrders">查看订单</view>
      <view class="btn btn-ghost btn-block" bindtap="goHome">返回首页</view>
    </view>
  </view>
</view>
