<view class="page" wx:if="{{order}}">
  <!-- 状态头 -->
  <view class="status-hero">
    <view class="status-main">
      <view class="badge {{statusCls}}" style="height:44rpx;font-size:26rpx;padding:0 18rpx;">{{statusText}}</view>
      <view class="status-desc" wx:if="{{order.status === 'unpaid'}}">请尽快完成支付，超时订单将取消</view>
      <view class="status-desc" wx:elif="{{order.status === 'ready' || order.status === 'paid'}}">
        {{order.payMode === 'cod' ? '到店取货时付款，核销后完成' : (order.fulfillment === 'delivery' ? '备货后送货上门，请保持手机畅通' : '凭下方核销码到自提点取货')}}
      </view>
      <view class="status-desc" wx:elif="{{order.status === 'verified'}}">感谢您的支持，期待再次光临</view>
      <view class="status-desc" wx:else>订单已取消</view>
    </view>
  </view>

  <!-- 核销码卡片 -->
  <view class="verify-card card" wx:if="{{verifyInfo && (order.status === 'ready' || order.status === 'paid' || order.status === 'verified')}}" bindtap="copyCode">
    <view class="vc-head">
      <text class="vc-title">🔖 提货核销码</text>
      <text class="badge {{verifyInfo.status === 'verified' ? 'badge-muted' : 'badge-primary'}}">
        {{verifyInfo.status === 'verified' ? '已核销' : '有效'}}
      </text>
    </view>
    <view class="vc-code">{{verifyInfo.code}}</view>
    <view class="vc-tip">点击复制核销码 · 向店员出示即可核销提货</view>
    <view class="vc-meta">订单号 {{verifyInfo.orderNo}}</view>
  </view>

  <!-- 自提点 -->
  <view class="card" wx:if="{{order.fulfillment !== 'delivery' && order.pickupPoint}}">
    <view class="row">
      <view class="pickup-icon">📍</view>
      <view class="flex-1">
        <view class="pickup-name">{{order.pickupPoint.name}}</view>
        <view class="pickup-addr">{{order.pickupPoint.address}}</view>
        <view class="pickup-phone" wx:if="{{order.pickupPoint.phone}}">📞 {{order.pickupPoint.phone}}</view>
      </view>
    </view>
  </view>

  <!-- 送货地址 -->
  <view class="card" wx:if="{{order.fulfillment === 'delivery' && order.deliveryAddress}}">
    <view class="row">
      <view class="pickup-icon">🚚</view>
      <view class="flex-1">
        <view class="pickup-name">{{order.deliveryAddress.community}} · {{order.deliveryAddress.building}}</view>
        <view class="pickup-addr">{{order.deliveryAddress.room}}</view>
        <view class="pickup-phone">{{order.deliveryAddress.contactName}} · {{order.deliveryAddress.contactPhone}}</view>
      </view>
    </view>
  </view>

  <!-- 商品 -->
  <view class="card">
    <view class="block-title">商品清单</view>
    <view class="order-item" wx:for="{{order.items}}" wx:key="id">
      <image class="o-cover" src="{{item.cover}}" mode="aspectFill" />
      <view class="o-info">
        <view class="o-title ellipsis">{{item.title}}</view>
        <view class="o-spec">{{item.skuName}}{{item.skuSpec ? ' · ' + item.skuSpec : ''}}</view>
      </view>
      <view class="o-right">
        <view class="price">
          <text class="price-symbol">¥</text>
          <text>{{item.price}}</text>
        </view>
        <view class="o-qty">x{{item.qty}}</view>
      </view>
    </view>
    <view class="divider"></view>
    <view class="row between">
      <text class="muted">商品总额</text>
      <text class="price" style="font-size:34rpx;">
        <text class="price-symbol">¥</text>
        <text>{{order.total}}</text>
      </text>
    </view>
  </view>

  <!-- 订单信息 -->
  <view class="card">
    <view class="info-row">
      <text class="info-label">订单编号</text>
      <view class="row">
        <text class="info-val">{{order.orderNo}}</text>
        <text class="copy" bindtap="copyOrderNo">复制</text>
      </view>
    </view>
    <view class="info-row">
      <text class="info-label">下单时间</text>
      <text class="info-val">{{order.createdAt}}</text>
    </view>
    <view class="info-row" wx:if="{{order.paidAt}}">
      <text class="info-label">支付时间</text>
      <text class="info-val">{{order.paidAt}}</text>
    </view>
    <view class="info-row" wx:if="{{order.verifiedAt}}">
      <text class="info-label">核销时间</text>
      <text class="info-val">{{order.verifiedAt}}</text>
    </view>
    <view class="info-row" wx:if="{{order.remark}}">
      <text class="info-label">订单备注</text>
      <text class="info-val">{{order.remark}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">提货方式</text>
      <text class="info-val">{{order.fulfillment === 'delivery' ? '送货上门' : '到店自提'}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">付款方式</text>
      <text class="info-val">
        {{order.payMode === 'cod' ? '到店付款' : '在线支付'}}
        <text class="badge {{order.paid ? 'badge-primary' : 'badge-warning'}}" style="margin-left:8rpx;">
          {{order.paid ? '已付款' : '未付款'}}
        </text>
      </text>
    </view>
    <view class="info-row" wx:if="{{order.fulfillment === 'delivery' && order.deliveryAddress}}">
      <text class="info-label">配送地址</text>
      <text class="info-val">{{order.deliveryAddress.community}} {{order.deliveryAddress.building}} {{order.deliveryAddress.room}}</text>
    </view>
  </view>

  <view class="page-pad-bottom" style="height:160rpx;" wx:if="{{order.status === 'unpaid'}}"></view>

  <!-- 底部操作 -->
  <view class="footer-bar {{barReady ? 'footer-bar--show' : ''}}" wx:if="{{order.status === 'unpaid'}}">
    <view class="flex-1"></view>
    <view class="btn btn-outline btn-sm" style="margin-right:16rpx;" bindtap="onCancel">取消订单</view>
    <view class="btn btn-primary" style="min-width:220rpx;height:76rpx;" bindtap="onPay">立即支付</view>
  </view>

  <view class="page-pad-bottom"></view>
</view>

<view class="loading-wrap" wx:elif="{{loading}}">
  <text>加载中…</text>
</view>

<view class="empty" wx:else>
  <view class="empty-icon">😕</view>
  <view class="empty-text">订单不存在</view>
  <view class="btn btn-primary" bindtap="goOrders">查看我的订单</view>
</view>
