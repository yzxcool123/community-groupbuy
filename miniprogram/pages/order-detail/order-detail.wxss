.page {
padding-bottom: 40rpx;
}

.status-hero {
  background: linear-gradient(135deg, #FF6700 0%, #E85D00 100%);
  padding: 40rpx 32rpx 56rpx;
  color: #FFFFFF;
}

.status-main .badge {
  background: rgba(255, 255, 255, 0.22) !important;
  color: #FFFFFF !important;
}

.status-desc {
  margin-top: 16rpx;
  font-size: 24rpx;
  opacity: 0.92;
}

/* 核销码卡片 */
.verify-card {
  margin-top: -28rpx;
  background: #FFFFFF;
  border: 2rpx solid rgba(255, 103, 0, 0.25);
  box-shadow: 0 8rpx 32rpx rgba(255, 103, 0, 0.12);
}

.vc-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.vc-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1F2329;
}

.vc-code {
  font-size: 72rpx;
  font-weight: 800;
  letter-spacing: 8rpx;
  color: #FF6700;
  text-align: center;
  font-family: 'DINAlternate', 'Menlo', 'Courier New', monospace;
  padding: 24rpx 0;
  background: #F2FBF6;
  border-radius: 12rpx;
  border: 2rpx dashed rgba(255, 103, 0, 0.35);
}

.vc-tip {
  text-align: center;
  color: #646A73;
  font-size: 22rpx;
  margin-top: 16rpx;
}

.vc-meta {
  text-align: center;
  color: #B0B6BF;
  font-size: 20rpx;
  margin-top: 10rpx;
}

.pickup-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.pickup-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2329;
}

.pickup-addr {
  font-size: 24rpx;
  color: #646A73;
  margin-top: 8rpx;
}

.pickup-phone {
  font-size: 22rpx;
  color: #FF6700;
  margin-top: 8rpx;
}

.block-title {
  font-size: 28rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}

.order-item {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
}

.o-cover {
  width: 110rpx;
  height: 110rpx;
  border-radius: 10rpx;
  background: #F2F3F5;
  flex-shrink: 0;
}

.o-info {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
}

.o-title {
  font-size: 26rpx;
  color: #1F2329;
  font-weight: 500;
}

.o-spec {
  font-size: 22rpx;
  color: #8B919B;
  margin-top: 8rpx;
}

.o-right {
  text-align: right;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.o-qty {
  font-size: 22rpx;
  color: #8B919B;
  margin-top: 6rpx;
}

.muted {
  color: #646A73;
  font-size: 26rpx;
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0;
}

.info-label {
  color: #646A73;
  font-size: 26rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.info-val {
  color: #1F2329;
  font-size: 26rpx;
  text-align: right;
  word-break: break-all;
}

.copy {
  color: #FF6700;
  font-size: 22rpx;
  margin-left: 16rpx;
  padding: 4rpx 12rpx;
  border: 1rpx solid rgba(255, 103, 0, 0.3);
  border-radius: 8rpx;
}
