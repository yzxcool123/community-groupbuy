.page {
padding-bottom: 60rpx;
}

.user-hero {
  display: flex;
  align-items: center;
  padding: 48rpx 32rpx;
  background: linear-gradient(135deg, #FF6700 0%, #E85D00 60%, #049647 100%);
  color: #FFFFFF;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  flex-shrink: 0;
  border: 4rpx solid rgba(255, 255, 255, 0.35);
}

.avatar-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
}

.user-info {
  flex: 1;
  margin-left: 24rpx;
  min-width: 0;
}

.nickname {
  font-size: 36rpx;
  font-weight: 700;
}

.user-sub {
  margin-top: 12rpx;
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
}

.role-tag {
  background: rgba(255, 255, 255, 0.22);
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
}

.logout {
  background: rgba(255, 255, 255, 0.2);
  font-size: 22rpx;
  padding: 10rpx 22rpx;
  border-radius: 24rpx;
}

/* 订单入口 */
.order-entry {
  margin-top: -28rpx;
  position: relative;
  z-index: 2;
}

.oe-head {
  margin-bottom: 24rpx;
}

.oe-title {
  font-size: 28rpx;
  font-weight: 700;
}

.oe-all {
  font-size: 22rpx;
  color: #646A73;
}

.oe-grid {
  display: flex;
}

.oe-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.oe-icon {
  font-size: 44rpx;
  margin-bottom: 10rpx;
}

.oe-label {
  font-size: 22rpx;
  color: #646A73;
}

/* 管理入口 */
.admin-entry {
  border: 1rpx solid rgba(255, 103, 0, 0.2);
  background: linear-gradient(180deg, #F3FBF6 0%, #FFFFFF 100%);
}

.ae-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.ae-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1F2329;
}

.ae-grid {
  display: flex;
}

.ae-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
  background: #FFFFFF;
  margin: 0 10rpx;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(255, 103, 0, 0.08);
}

.ae-icon {
  font-size: 44rpx;
  margin-bottom: 10rpx;
}

.ae-label {
  font-size: 22rpx;
  color: #1F2329;
  font-weight: 500;
}

/* 菜单 */
.menu-card {
  padding: 8rpx 24rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  height: 100rpx;
  border-bottom: 1rpx solid #F0F1F3;
}

.menu-item:last-child {
  border-bottom: none;
}

.m-icon {
  font-size: 32rpx;
  margin-right: 18rpx;
}

.m-label {
  font-size: 28rpx;
  color: #1F2329;
}

.m-arrow {
  color: #C9CDD4;
  font-size: 32rpx;
}

.page-foot {
  text-align: center;
  color: #B0B6BF;
  font-size: 22rpx;
  margin-top: 40rpx;
}
