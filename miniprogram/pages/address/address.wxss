.page {
  padding: 20rpx 24rpx 40rpx;
}

.tip {
  font-size: 22rpx;
  color: #8B919B;
  margin-bottom: 16rpx;
}

.addr-item {
  background: #FFFFFF;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(31, 35, 41, 0.04);
}

.a-main {
  padding: 24rpx;
}

.a-line1 {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 10rpx;
}

.a-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2329;
}

.a-phone {
  font-size: 24rpx;
  color: #646A73;
}

.a-line2 {
  font-size: 28rpx;
  color: #1F2329;
  margin-bottom: 6rpx;
}

.a-text {
  font-size: 22rpx;
  color: #8B919B;
}

.a-ops {
  display: flex;
  justify-content: flex-end;
  gap: 8rpx;
  padding: 12rpx 16rpx;
  border-top: 1rpx solid #F0F1F3;
  background: #FAFBFC;
}

.a-op {
  padding: 10rpx 20rpx;
  font-size: 22rpx;
  color: #646A73;
  border-radius: 8rpx;
  background: #FFFFFF;
  border: 1rpx solid #E5E6EB;
}

.a-op.danger {
  color: #FA2C19;
  border-color: #FFD6D3;
}
