<view class="page">
  <!-- 核心指标 -->
  <view class="stat-grid">
    <view class="stat-card">
      <view class="stat-num">{{stats.todayOrders || 0}}</view>
      <view class="stat-label">今日订单</view>
    </view>
    <view class="stat-card">
      <view class="stat-num price-text">¥{{stats.gmv || '0.00'}}</view>
      <view class="stat-label">累计 GMV</view>
    </view>
    <view class="stat-card">
      <view class="stat-num warn-text">{{stats.pendingVerify || 0}}</view>
      <view class="stat-label">待核销</view>
    </view>
    <view class="stat-card">
      <view class="stat-num">{{stats.productCount || 0}}</view>
      <view class="stat-label">在售商品</view>
    </view>
  </view>

  <!-- 快捷入口 -->
  <view class="card">
    <view class="block-title">快捷入口</view>
    <view class="quick-grid">
      <view
        class="quick-item"
        wx:for="{{quickLinks}}"
        wx:key="label"
        data-url="{{item.url}}"
        data-perm="{{item.perm}}"
        bindtap="onQuickTap"
      >
        <view class="q-icon">{{item.icon}}</view>
        <view class="q-label">{{item.label}}</view>
      </view>
    </view>
  </view>

  <!-- 近7日趋势 -->
  <view class="card" wx:if="{{stats && stats.bars && stats.bars.length}}">
    <view class="block-title">近 7 日 GMV</view>
    <view class="chart">
      <view class="chart-col" wx:for="{{stats.bars}}" wx:key="date">
        <view class="bar-val">¥{{item.gmvText}}</view>
        <view class="bar-track">
          <view class="bar" style="height:{{item.height}}rpx;"></view>
        </view>
        <view class="bar-date">{{item.date}}</view>
      </view>
    </view>
  </view>

  <!-- 热销 Top -->
  <view class="card" wx:if="{{stats && stats.hot && stats.hot.length}}">
    <view class="block-title">热销 Top5</view>
    <view class="hot-row" wx:for="{{stats.hot}}" wx:key="title">
      <view class="hot-rank {{index < 3 ? 'top' : ''}}">{{index + 1}}</view>
      <image class="hot-cover" src="{{item.cover}}" mode="aspectFill" />
      <view class="hot-info">
        <view class="hot-title ellipsis">{{item.title}}</view>
        <view class="hot-meta">已售 {{item.qty}} 件</view>
      </view>
      <view class="price">
        <text class="price-symbol">¥</text>
        <text>{{item.amount}}</text>
      </view>
    </view>
  </view>

  <view class="loading-wrap" wx:if="{{loading}}">
    <text>加载中…</text>
  </view>

  <view class="empty" wx:if="{{!loading && !stats}}">
    <view class="empty-icon">📊</view>
    <view class="empty-text">暂无看板数据（需 stats:read 权限）</view>
    <view class="btn btn-primary" bindtap="goVerify">去核销</view>
  </view>

  <view class="page-pad-bottom"></view>
</view>
