.page {
padding-bottom: 40rpx;
}

.section {
  background: #FFFFFF;
  margin: 20rpx 24rpx;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(31, 35, 41, 0.04);
}

.sec-title {
  font-size: 28rpx;
  font-weight: 700;
  padding: 24rpx 24rpx 8rpx;
  margin-bottom: 8rpx;
}

.sec-title-row {
  padding: 24rpx 24rpx 8rpx;
}

.add-sku {
  color: #FF6700;
  font-size: 24rpx;
  font-weight: 600;
}

.form-textarea {
  flex: 1;
  height: 140rpx;
  font-size: 26rpx;
  color: #1F2329;
  line-height: 1.5;
}

.picker-val {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 96rpx;
  font-size: 28rpx;
  color: #1F2329;
}

.picker-arrow {
  color: #C9CDD4;
  font-size: 32rpx;
}

.type-row {
  flex: 1;
  display: flex;
  gap: 12rpx;
}

.type-chip {
  padding: 12rpx 24rpx;
  background: #F2F3F5;
  border-radius: 10rpx;
  font-size: 24rpx;
  color: #646A73;
  border: 2rpx solid transparent;
}

.type-chip.on {
  background: rgba(255, 103, 0, 0.1);
  color: #FF6700;
  border-color: #FF6700;
  font-weight: 600;
}

.sku-card {
  margin: 12rpx 24rpx 24rpx;
  background: #F7F8FA;
  border-radius: 12rpx;
  overflow: hidden;
}

.sku-head {
  padding: 16rpx 24rpx;
  background: #F2F3F5;
}

.sku-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #1F2329;
}

.sku-del {
  font-size: 22rpx;
  color: #FA2C19;
  padding: 4rpx 12rpx;
}
