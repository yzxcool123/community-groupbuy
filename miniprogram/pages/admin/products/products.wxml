<view class="page">
  <!-- tab -->
  <view class="tabs">
    <view
      class="tab-item {{activeTab === item.key ? 'active' : ''}}"
      wx:for="{{tabs}}"
      wx:key="key"
      data-key="{{item.key}}"
      bindtap="onTabTap"
    >
      <text>{{item.label}}</text>
      <view class="tab-line" wx:if="{{activeTab === item.key}}"></view>
    </view>
    <view class="create-btn" bindtap="onOpenCats">分类</view>
    <view class="create-btn" bindtap="onCreate">+ 新建</view>
  </view>

  <view class="loading-wrap" wx:if="{{loading}}">
    <text>加载中…</text>
  </view>

  <block wx:if="{{!loading}}">
    <view class="p-card card-flat" wx:for="{{list}}" wx:key="id">
      <image class="p-cover" src="{{item.cover}}" mode="aspectFill" />
      <view class="p-info">
        <view class="row between">
          <view class="p-title ellipsis">{{item.title}}</view>
          <text class="badge {{item.status === 'on' ? 'badge-primary' : 'badge-muted'}}">
            {{item.status === 'on' ? '在售' : '已下架'}}
          </text>
        </view>
        <view class="p-meta">
          <text class="badge badge-info" wx:if="{{item.saleType === 'presale'}}">预售</text>
          <text class="badge badge-warning" wx:if="{{item.isHot}}">热销</text>
          <text class="p-cat">{{item.categoryName}}</text>
        </view>
        <view class="row between p-bottom">
          <view class="price">
            <text class="price-symbol">¥</text>
            <text>{{item.minPrice}}</text>
          </view>
          <view class="p-actions">
            <view class="btn btn-sm btn-ghost" data-id="{{item.id}}" bindtap="onEdit">编辑</view>
            <view
              class="btn btn-sm {{item.status === 'on' ? 'btn-outline' : 'btn-primary'}}"
              data-id="{{item.id}}"
              data-status="{{item.status}}"
              bindtap="onToggleStatus"
            >
              {{item.status === 'on' ? '下架' : '上架'}}
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="empty" wx:if="{{!list.length}}">
      <view class="empty-icon">📦</view>
      <view class="empty-text">{{activeTab === 'on' ? '暂无在售商品' : '暂无下架商品'}}</view>
      <view class="btn btn-primary" bindtap="onCreate">新建商品</view>
    </view>
  </block>

  <view class="page-pad-bottom" style="height:160rpx;"></view>
  <view class="footer-bar {{barReady ? 'footer-bar--show' : ''}}">
    <view class="btn btn-primary btn-block" bindtap="onCreate">+ 新建商品</view>
  </view>

  <!-- 分类管理弹层 -->
  <view class="cat-mask" wx:if="{{showCat}}" bindtap="onCloseCats">
    <view class="cat-panel" catchtap="noop">
      <view class="cat-head">
        <text class="cat-title">分类管理</text>
        <text class="cat-close" bindtap="onCloseCats">完成</text>
      </view>

      <view class="cat-add-row">
        <input class="cat-input" placeholder="分类名称，如：零食" value="{{newCatName}}" bindinput="onNewCatName" />
        <input class="cat-input cat-icon-input" placeholder="图标" value="{{newCatIcon}}" bindinput="onNewCatIcon" />
        <view class="btn btn-sm btn-primary" bindtap="onAddCat">添加</view>
      </view>

      <view class="loading-wrap" wx:if="{{catLoading}}">加载中…</view>

      <scroll-view class="cat-list" scroll-y wx:if="{{!catLoading}}">
        <view class="cat-item" wx:for="{{categories}}" wx:key="id">
          <view class="cat-row">
            <input class="cat-icon" value="{{item.icon}}" data-id="{{item.id}}" data-f="icon" bindinput="onCatField" />
            <input class="cat-name" value="{{item.name}}" data-id="{{item.id}}" data-f="name" bindinput="onCatField" />
            <view class="cat-status {{item.status === 'disabled' ? 'off' : ''}}" data-id="{{item.id}}" bindtap="onCatStatusToggle">
              {{item.status === 'disabled' ? '停用' : '启用'}}
            </view>
          </view>
          <view class="cat-ops">
            <view class="cat-sort">
              <text class="muted">排序</text>
              <input class="cat-sort-input" type="number" value="{{item.sort}}" data-id="{{item.id}}" data-f="sort" bindinput="onCatField" />
            </view>
            <view class="cat-ops-btns">
              <view class="btn btn-sm btn-ghost" data-id="{{item.id}}" bindtap="onSaveCat">保存</view>
              <view class="btn btn-sm btn-danger" data-id="{{item.id}}" bindtap="onDeleteCat">删除</view>
            </view>
          </view>
        </view>
        <view class="empty" wx:if="{{!categories.length}}">
          <view class="empty-text">暂无分类，先添加一个吧</view>
        </view>
      </scroll-view>
    </view>
  </view>
</view>
